PORT=3000
NODE_ENV=development

# Admin login
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Random string, 32+ characters (signs the login cookie)
SESSION_SECRET=replace-with-a-long-random-string

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hillview

# Vercel Blob read/write token (photos). Leave empty locally to save photos to ./uploads
BLOB_READ_WRITE_TOKEN=

# Optional. Only set once you have a custom domain; otherwise links use the address you open the admin on.
PUBLIC_URL=
